/* GENERATED by theme-switch.sh - waybar-pill styled picker (used by theme / wallpaper / clipboard pickers) */
* {
    base:     #24273a;
    mantle:   #1e2030;
    crust:    #181926;
    surface0: #363a4f;
    surface2: #5b6078;
    text:     #cad3f5;
    subtext:  #a5adcb;
    accent:   #b7bdf8;
    accent2:  #c6a0f6;
    urgent:   #ed8796;
    font: "GeistMono Nerd Font Mono 12";
}

configuration {
    show-icons: false;
}

window {
    transparency: "real";
    location: center;
    anchor: center;
    width: 520px;
    border: 4px solid;
    border-color: @base;
    border-radius: 18px;
    background-color: @mantle;
}

mainbox {
    background-color: transparent;
    spacing: 10px;
    padding: 14px;
    children: [ "inputbar", "listview" ];
}

inputbar {
    background-color: @crust;
    border: 4px solid;
    border-color: @base;
    border-radius: 18px;
    padding: 8px 14px;
    spacing: 10px;
    children: [ "prompt", "entry" ];
}

prompt {
    background-color: transparent;
    text-color: @accent2;
}

entry {
    background-color: transparent;
    text-color: @text;
    placeholder: "type to filter...";
    placeholder-color: @surface2;
}

listview {
    background-color: transparent;
    lines: 8;
    columns: 1;
    fixed-height: false;
    scrollbar: false;
    spacing: 6px;
}

element {
    background-color: @crust;
    text-color: @subtext;
    border: 4px solid;
    border-color: @base;
    border-radius: 18px;
    padding: 6px 14px;
}

element selected.normal {
    background-color: @surface0;
    text-color: @accent;
    border-color: @accent;
}

element-text {
    background-color: transparent;
    text-color: inherit;
}
