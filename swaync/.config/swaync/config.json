{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "cssPriority": "user",
  "control-center-width": 400,
  "control-center-height": 700,
  "control-center-margin-top": 2,
  "control-center-margin-bottom": 2,
  "control-center-margin-right": 1,
  "control-center-margin-left": 0,
  "control-center-preferred-output": "DP-3",
  "notification-window-preferred-output": "DP-3",
  "notification-window-width": 400,
  "notification-icon-size": 48,
  "notification-body-image-height": 160,
  "notification-body-image-width": 200,
  "notification-grouping": true,
  "notification-inline-replies": true,
  "timeout": 6,
  "timeout-low": 3,
  "timeout-critical": 0,
  "fit-to-screen": false,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "script-fail-notify": true,
  "scripts": {
    "sound-normal": {
      "app-name": ".*",
      "urgency": "Normal",
      "exec": "paplay /usr/share/sounds/freedesktop/stereo/message.oga"
    },
    "sound-critical": {
      "app-name": ".*",
      "urgency": "Critical",
      "exec": "paplay /usr/share/sounds/freedesktop/stereo/dialog-warning.oga"
    }
  },
  "widgets": [
    "title",
    "dnd",
    "buttons-grid",
    "volume",
    "mpris",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "󰎟 Clear"
    },
    "dnd": {
      "text": "Do not disturb"
    },
    "volume": {
      "label": "󰕾",
      "show-per-app": false
    },
    "mpris": {
      "image-size": 96,
      "image-radius": 12
    },
    "buttons-grid": {
      "buttons-per-row": 4,
      "actions": [
        {
          "label": "󰌾",
          "command": "~/.config/hypr/scripts/lock.sh"
        },
        {
          "label": "󰅶",
          "command": "sh -c 'if pkill -x hypridle; then notify-send -a idle \"Idle lock OFF\"; else (hypridle >/dev/null 2>&1 &); notify-send -a idle \"Idle lock ON\"; fi'"
        },
        {
          "label": "󰅌",
          "command": "sh -c '~/.config/hypr/scripts/clipboard.sh'"
        },
        {
          "label": "󰸉",
          "command": "sh -c '~/.config/hypr/scripts/wallpaper-pick.sh span'"
        },
        {
          "label": "󰔎",
          "command": "sh -c '~/.config/themes/theme-switch.sh pick'"
        },
        {
          "label": "󰖔",
          "command": "~/.config/hypr/scripts/nightlight.sh toggle"
        },
        {
          "label": "󰂯",
          "command": "blueman-manager"
        },
        {
          "label": "󰃟",
          "command": "~/.config/hypr/scripts/screenshot.sh region"
        }
      ]
    }
  }
}
