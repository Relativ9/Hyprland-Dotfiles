[
  {
    "name": "left",
    "layer": "top",
    "position": "top",
    "output": ["HDMI-A-2"],
    "margin-top": 10,
    "modules-center": ["group/wsbox"],

    "group/wsbox": {
      "orientation": "horizontal",
      "modules": ["ext/workspaces", "custom/special"]
    },

    "ext/workspaces": {
      "format": "{name}",
      "sort-by-id": true,
      "all-outputs": false
    },

    "custom/special": {
      "exec": "~/.config/waybar/scripts/special-indicator.sh HDMI-A-2",
      "interval": 1,
      "return-type": "json",
      "format": "{}",
      "hide-empty-text": true,
      "tooltip": true
    }
  },
  {
    "name": "right",
    "layer": "top",
    "position": "top",
    "output": ["DP-2"],
    "margin-top": 10,
    "modules-center": ["group/wsbox"],

    "group/wsbox": {
      "orientation": "horizontal",
      "modules": ["ext/workspaces", "custom/special"]
    },

    "ext/workspaces": {
      "format": "{name}",
      "sort-by-id": true,
      "all-outputs": false
    },

    "custom/special": {
      "exec": "~/.config/waybar/scripts/special-indicator.sh DP-2",
      "interval": 1,
      "return-type": "json",
      "format": "{}",
      "hide-empty-text": true,
      "tooltip": true
    }
  }
]
