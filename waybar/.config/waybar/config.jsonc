{
  "layer": "top",
  "position": "top",
  "margin-top": 10,
  "output": ["DP-3"],
  

  "modules-left": [
    "group/cpu",
    "group/gpu",
    "group/vram",
    "group/network"
  ],
  "modules-center": [
    "group/wsbox",
    "clock"
  ],
    "modules-right": [
    "group/audio",
    "bluetooth",
    "group/keyboard",
    "group/proton",
    "group/notification",
    "group/power"
  ],

    /* --- GROUP DEFINITIONS --- */
  
  "group/cpu": {
    "orientation": "horizontal",
    "modules": ["custom/cpu-toggle"],
  },
  
  "group/gpu": {
    "orientation": "horizontal", 
    "modules": ["custom/gpu-core-toggle"],
  },

  "group/vram": {
    "orientation": "horizontal",
    "modules": ["custom/gpu-vram-toggle"],
  },
  
  "group/network": {
    "orientation": "horizontal",
    "modules": ["custom/network-toggle"],
  },
  
  "group/keyboard": {
    "orientation": "horizontal",
    "modules": ["custom/keyboard-cycle"],
  },
  
  "group/notification": {
      "orientation": "horizontal",
      "modules": ["custom/notification"],
  },

  "group/power": {
      "orientation": "horizontal",
      "modules": ["custom/power"],
  },

  "group/proton": {
      "orientation": "horizontal",
      "modules": ["custom/proton"],
  },

  "group/audio": {
    "orientation": "horizontal",
    "modules": ["pulseaudio", "pulseaudio/slider"],
    "drawer": { 
      "transition-duration": 200,  // Animation duration in ms, or 0 for instant
      "transition-left-to-right": false
    }
  },



  /* --- LEFT: PERFORMANCE BUTTONS --- */
  "custom/cpu-toggle": {
    "exec": "~/.config/waybar/scripts/cpu-toggle.sh",
    "interval": 2,
    "return-type": "json",
    "on-click": "~/.config/waybar/scripts/cpu-toggle.sh toggle",
    "tooltip": true
  },
  
  "custom/gpu-core-toggle": {
    "exec": "~/.config/waybar/scripts/gpu-core-toggle.sh",
    "interval": 2,
    "return-type": "json",
    "on-click": "~/.config/waybar/scripts/gpu-core-toggle.sh toggle",
    "tooltip": true
  },
  
  "custom/gpu-vram-toggle": {
    "exec": "~/.config/waybar/scripts/gpu-vram-toggle.sh",
    "interval": 2,
    "return-type": "json",
    "on-click": "~/.config/waybar/scripts/gpu-vram-toggle.sh toggle",
    "tooltip": true
  },
  
  "custom/network-toggle": {
    "exec": "~/.config/waybar/scripts/network-toggle.sh",
    "interval": 5,
    "return-type": "json",
    "on-click": "~/.config/waybar/scripts/network-toggle.sh toggle",
    "tooltip": true
  },

  /* --- CENTER: TEMPLATE (Unchanged) --- */

  "group/wsbox": {
    "orientation": "horizontal",
    "modules": ["custom/ws-1", "custom/ws-2", "custom/ws-3", "custom/ws-4", "custom/ws-5", "custom/special"]
  },

  "custom/ws-1": {
    "exec": "~/.config/waybar/scripts/ws-button.sh 1",
    "interval": 1,
    "return-type": "json",
    "format": "{}",
    "tooltip": true,
    "on-click": "~/.config/waybar/scripts/ws-button.sh focus 1"
  },
  "custom/ws-2": {
    "exec": "~/.config/waybar/scripts/ws-button.sh 2",
    "interval": 1,
    "return-type": "json",
    "format": "{}",
    "tooltip": true,
    "on-click": "~/.config/waybar/scripts/ws-button.sh focus 2"
  },
  "custom/ws-3": {
    "exec": "~/.config/waybar/scripts/ws-button.sh 3",
    "interval": 1,
    "return-type": "json",
    "format": "{}",
    "tooltip": true,
    "on-click": "~/.config/waybar/scripts/ws-button.sh focus 3"
  },
  "custom/ws-4": {
    "exec": "~/.config/waybar/scripts/ws-button.sh 4",
    "interval": 1,
    "return-type": "json",
    "format": "{}",
    "tooltip": true,
    "on-click": "~/.config/waybar/scripts/ws-button.sh focus 4"
  },
  "custom/ws-5": {
    "exec": "~/.config/waybar/scripts/ws-button.sh 5",
    "interval": 1,
    "return-type": "json",
    "format": "{}",
    "tooltip": true,
    "on-click": "~/.config/waybar/scripts/ws-button.sh focus 5"
  },
  "custom/ws-11": {
    "exec": "~/.config/waybar/scripts/ws-button.sh 11",
    "interval": 1,
    "return-type": "json",
    "format": "{}",
    "tooltip": true,
    "on-click": "~/.config/waybar/scripts/ws-button.sh focus 11"
  },
  "custom/ws-12": {
    "exec": "~/.config/waybar/scripts/ws-button.sh 12",
    "interval": 1,
    "return-type": "json",
    "format": "{}",
    "tooltip": true,
    "on-click": "~/.config/waybar/scripts/ws-button.sh focus 12"
  },
  "custom/ws-13": {
    "exec": "~/.config/waybar/scripts/ws-button.sh 13",
    "interval": 1,
    "return-type": "json",
    "format": "{}",
    "tooltip": true,
    "on-click": "~/.config/waybar/scripts/ws-button.sh focus 13"
  },
  "custom/ws-21": {
    "exec": "~/.config/waybar/scripts/ws-button.sh 21",
    "interval": 1,
    "return-type": "json",
    "format": "{}",
    "tooltip": true,
    "on-click": "~/.config/waybar/scripts/ws-button.sh focus 21"
  },
  "custom/ws-22": {
    "exec": "~/.config/waybar/scripts/ws-button.sh 22",
    "interval": 1,
    "return-type": "json",
    "format": "{}",
    "tooltip": true,
    "on-click": "~/.config/waybar/scripts/ws-button.sh focus 22"
  },
  "custom/ws-23": {
    "exec": "~/.config/waybar/scripts/ws-button.sh 23",
    "interval": 1,
    "return-type": "json",
    "format": "{}",
    "tooltip": true,
    "on-click": "~/.config/waybar/scripts/ws-button.sh focus 23"
  },
  "custom/special": {
    "exec": "~/.config/waybar/scripts/special-indicator.sh DP-3",
    "interval": 1,
    "return-type": "json",
    "format": "{}",
    "hide-empty-text": true,
    "tooltip": true
  },

  "clock": {
    "interval": 1,
    "format": "{:%H:%M}",
    "format-alt": "{:%A, %d %B %Y}",
    "tooltip": true,
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "format": { "today": "<span color='#f5bde6'><b><u>{}</u></b></span>" }
    },
    "on-click": "mode"
  },

  /* --- RIGHT: CONTROL BUTTONS --- */

  "custom/keyboard-cycle": {
    "exec": "~/.config/waybar/scripts/keyboard-cycle.sh",
    "interval": 60,           // Check every 60s (in case changed externally)
    "return-type": "json",
    "format": "{}",
    "on-click": "~/.config/waybar/scripts/keyboard-cycle.sh toggle",
    "tooltip": true,
    "restart-interval": 5     // Restart script if it crashes
  },

  "pulseaudio": {
    "format": "{volume}% {icon} ",
    "format-muted": " 0%",
    "format-icons": {
      "default": ["", ""]
    },
    "on-click": "pavucontrol",
    "on-click-right": "mode",
    "scroll-step": 5,
    "tooltip": true,
    "tooltip-format": "{desc}"
  },

  "pulseaudio/slider": {
    "min": 0,
    "max": 100,
    "orientation": "horizontal"
  },

  "bluetooth": {
    "format": "󰂯",
    "format-on": "󰂯",
    "format-off": "󰂲",
    "format-disabled": "󰂲",
    "format-connected": "󰂱 {num_connections}",
    "tooltip-format": "{controller_alias}\t{controller_address}",
    "tooltip-format-connected": "{controller_alias}\n{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "on-click": "blueman-manager",
    "on-click-right": "rfkill toggle bluetooth"
  },

  "custom/notification": {
    "format": "{icon}",
    "format-icons": {
      "notification": "󱅫",
      "none": "󰂜",
      "dnd-notification": "󰂠",
      "dnd-none": "󰪓"
    },
    "return-type": "json",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "exec-if": "which swaync-client"
  },

  "custom/proton": {
    "exec": "~/.config/waybar/scripts/proton-toggle.sh",
    "interval": 5,
    "return-type": "json",
    "format": "{}",
    "on-click": "protonvpn-app",  // Opens your GUI
    "tooltip": true
  },

  "custom/power": {
    "format": "",
    "tooltip": true,
    "tooltip-format": "Click: Power Menu\nRight: Suspend",
    "on-click": "wlogout",
    "on-click-right": "systemctl suspend"
  }
}

