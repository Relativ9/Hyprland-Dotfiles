{
    "label" : "lock",
    "action" : "~/.config/hypr/scripts/lock.sh",
    "text" : "󰌾 Lock",
    "keybind" : "l"
}
{
    "label" : "logout",
    "action" : "hyprctl dispatch exit",
    "text" : "󰍃 Logout",
    "keybind" : "e"
}
{
    "label" : "suspend",
    "action" : "systemctl suspend",
    "text" : "󰤄 Suspend",
    "keybind" : "s"
}
{
    "label" : "restart",
    "action" : "systemctl reboot",
    "text" : "󰜉 Restart",
    "keybind" : "r"
}
{
    "label" : "shutdown",
    "action" : "systemctl poweroff",
    "text" : "󰐥 Shutdown",
    "keybind" : "p"
}

